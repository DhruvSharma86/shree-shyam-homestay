# Root gitignore — secrets & local state are never committed.
.env
*.env
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
node_modules/
Git-Auto-Commit-Push.cmd

# Temporary SQLite/local database artifacts — never committed (Phase 4.3
# hygiene: scratch databases such as mig*.db must stay untracked).
*.db
*.sqlite
*.sqlite3
*-journal
*-wal
*-shm

# Desktop (Phase 6.4) — build outputs & staged runtimes are never committed.
# The generated Windows installer is a local release artifact, not a repo file.
desktop/node_modules/
desktop/dist/
desktop/.cache/
backend/packaging/build/
backend/packaging/dist/
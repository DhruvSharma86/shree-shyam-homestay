# ---------------------------------------------------------------------------
# Shree Shyam Home Stay — backend environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored — NEVER commit it.
# ---------------------------------------------------------------------------

# Application
APP_NAME=Shree Shyam Home Stay Management System
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# Database (PostgreSQL via psycopg v3 — matches docker-compose `db` service)
DATABASE_URL=postgresql+psycopg://hotel_app:change_me@localhost:5432/shree_shyam
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# API
API_V1_PREFIX=/api/v1

# Secrets — generate strong random values for anything beyond local dev.
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_COOKIE_NAME=sshs_session
CSRF_COOKIE_NAME=sshs_csrf
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PORTAL_RATE_LIMIT_ATTEMPTS=60
PORTAL_RATE_LIMIT_WINDOW_SECONDS=300
TRUSTED_PROXY_ENABLED=false

# Initial admin bootstrap (Phase 1.2). Leave empty to skip bootstrap.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Hotel Administrator
